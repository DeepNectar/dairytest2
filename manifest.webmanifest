{
  "name": "Dairy Writing — Daily Journal",
  "short_name": "Dairy Writing",
  "description": "A cozy daily writing journal. Write, save and reflect on your entries — synced in the cloud, works like a native app on iOS and Android.",
  "id": "/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f6efe4",
